{
  "name": "@deltares/webgl-streamline-visualizer",
  "description": "Particle-based flow field visualiser based on WebGL",
  "license": "MIT",
  "private": false,
  "version": "5.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/webgl-streamline-visualizer.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webgl-streamline-visualizer.js"
    }
  },
  "homepage": "https://deltares.github.io/webgl-streamline-visualizer/",
  "scripts": {
    "dev": "vite build --config vite-examples.config.ts",
    "build": "vite build --config vite-library.config.ts && tsc -p tsconfig.build.json",
    "build-examples": "tsc && vite build --config vite-examples.config.ts",
    "lint": "eslint \"./src/**/*.ts\" \"./examples/**/*.ts\"",
    "preview": "vite preview",
    "test": "vitest",
    "test-once": "vitest run",
    "patch-package": "patch-package"
  },
  "devDependencies": {
    "@deltares/fews-wms-requests": "^4.3.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-glsl": "^1.6.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "geotiff": "^3.1.0-beta.0",
    "maplibre-gl": "^6.16.0"
  },
  "volta": {
    "node": "22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deltares/webgl-streamline-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Deltares/webgl-streamline-visualizer/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  }
}
